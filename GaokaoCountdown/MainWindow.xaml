<Window x:Class="GaokaoCountdown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GaokaoCountdown"
        mc:Ignorable="d"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#00000000"
        AllowsTransparency="True"
        Height="100" Width="1300"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged"
        Title="CEE Countdown by Mr.Anonymous"
        ShowInTaskbar="False">
    <Grid MouseMove="Grid_MouseMove">
        <ProgressBar Margin="0,0,0,80" x:Name="ProgbarYear" Height="20" Maximum="366"/>
        <ProgressBar Margin="0,20,0,60" x:Name="ProgbarDay" Height="20" Maximum="24" Foreground="{Binding Foreground, ElementName=ProgbarYear}"/>
        <ProgressBar Margin="0,40,0,40" x:Name="ProgbarHour" Height="20" Maximum="60" Foreground="{Binding Foreground, ElementName=ProgbarYear}"/>
        <ProgressBar Margin="0,60,0,20" x:Name="ProgbarMin" Height="20" Maximum="60" Foreground="{Binding Foreground, ElementName=ProgbarYear}"/>
        <ProgressBar Margin="0,80,0,0" x:Name="ProgbarSec" Height="20" Maximum="1000" Foreground="{Binding Foreground, ElementName=ProgbarYear}"/>
        <Rectangle Fill="#99000000" Height="100"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-2,0,0">
            <TextBlock x:Name="Title"
                       HorizontalAlignment="Center"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="60"
                       Foreground="#ffffff"
                       Text="距离高考还有" Background="#00000000">
                <TextBlock.Effect>
                    <DropShadowEffect/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock x:Name="Days"
                       Margin="20,-5,0,0"
                       Foreground="#36b161"
                       Background="Transparent"
                       HorizontalAlignment="Center"
                       FontFamily="#Cascadia Mono Bold"
                       FontSize="80"
                       Text="100">
                <TextBlock.Effect>
                    <DropShadowEffect/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Background="Transparent"
                       HorizontalAlignment="Center"
                       FontFamily="Microsoft YaHei UI"
                       Margin="20,2,0,0"
                       Foreground="#ffffff"
                       FontSize="60"
                       Text="天">
                <TextBlock.Effect>
                    <DropShadowEffect/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock x:Name="Hours"
                       Margin="20,-5,0,0"
                       Foreground="{Binding Foreground, ElementName=Days}"
                       Background="Transparent"
                       HorizontalAlignment="Center"
                       FontFamily="#Cascadia Mono Bold"
                       FontSize="80"
                       Text="00">
                <TextBlock.Effect>
                    <DropShadowEffect/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Background="Transparent"
                       HorizontalAlignment="Center"
                       Foreground="#ffffff"
                       FontFamily="Microsoft YaHei UI"
                       Margin="20,2,0,0"
                       FontSize="60"
                       Text="时">
                <TextBlock.Effect>
                    <DropShadowEffect/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock x:Name="Mins"
                       Margin="20,-5,0,0"
                       Foreground="{Binding Foreground, ElementName=Days}"
                       Background="Transparent"
                       HorizontalAlignment="Center"
                       FontFamily="#Cascadia Mono Bold"
                       FontSize="80"
                       Text="00">
                <TextBlock.Effect>
                    <DropShadowEffect/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Background="Transparent"
                       HorizontalAlignment="Center"
                       FontFamily="Microsoft YaHei UI"
                       Margin="20,2,0,0"
                       Foreground="#ffffff"
                       FontSize="60"
                       Text="分">
                <TextBlock.Effect>
                    <DropShadowEffect/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock x:Name="Secs"
                       Margin="20,-5,0,0"
                       Foreground="{Binding Foreground, ElementName=Days}"
                       Background="Transparent"
                       HorizontalAlignment="Center"
                       FontFamily="#Cascadia Mono Bold"
                       FontSize="80"
                       Text="00">
                <TextBlock.Effect>
                    <DropShadowEffect/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock x:Name="Millisecs"
                       Margin="20,5,0,0"
                       Foreground="{Binding Foreground, ElementName=Days}"
                       Background="Transparent"
                       VerticalAlignment="Center"
                       FontFamily="#Cascadia Mono Bold"
                       FontSize="40"
                       Text="000">
                <TextBlock.Effect>
                    <DropShadowEffect/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Background="Transparent"
                       HorizontalAlignment="Center"
                       FontFamily="Microsoft YaHei UI"
                       Margin="20,2,0,0"
                       Foreground="#ffffff"
                       FontSize="60"
                       Text="秒">
                <TextBlock.Effect>
                    <DropShadowEffect/>
                </TextBlock.Effect>
            </TextBlock>

        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center">
            <TextBlock x:Name="TitleEN"
                       Background="Transparent"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Foreground="#ffffff"
                       FontSize="24"
                       FontFamily="Microsoft YaHei UI"
                       Text="Time to College Entrance Examination">
                <TextBlock.Effect>
                    <DropShadowEffect/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Margin="10,-5,0,0"
                       Foreground="{Binding Foreground, ElementName=Days}"
                       Background="Transparent"
                       HorizontalAlignment="Center"
                       FontFamily="#Cascadia Mono Bold"
                       VerticalAlignment="Bottom"
                       FontSize="24"
                       Text="{Binding Text, ElementName=Days}">
                <TextBlock.Effect>
                    <DropShadowEffect/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Background="Transparent"
                       HorizontalAlignment="Center"
                       FontFamily="Microsoft YaHei UI"
                       Margin="10,2,0,0"
                       Foreground="#ffffff"
                       VerticalAlignment="Bottom"
                       FontSize="24"
                       Text="Days">
                <TextBlock.Effect>
                    <DropShadowEffect/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Margin="10,-5,0,0"
                       Foreground="{Binding Foreground, ElementName=Days}"
                       Background="Transparent"
                       HorizontalAlignment="Center"
                       FontFamily="#Cascadia Mono Bold"
                       VerticalAlignment="Bottom"
                       FontSize="24"
                       Text="{Binding Text, ElementName=Hours}">
                <TextBlock.Effect>
                    <DropShadowEffect/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Background="Transparent"
                       HorizontalAlignment="Center"
                       FontFamily="Microsoft YaHei UI"
                       Margin="10,2,0,0"
                       Foreground="#ffffff"
                       VerticalAlignment="Bottom"
                       FontSize="24"
                       Text="Hours">
                <TextBlock.Effect>
                    <DropShadowEffect/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Margin="10,-5,0,0"
                       Foreground="{Binding Foreground, ElementName=Days}"
                       Background="Transparent"
                       HorizontalAlignment="Center"
                       FontFamily="#Cascadia Mono Bold"
                       VerticalAlignment="Bottom"
                       FontSize="24"
                       Text="{Binding Text, ElementName=Mins}">
                <TextBlock.Effect>
                    <DropShadowEffect/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Background="Transparent"
                       HorizontalAlignment="Center"
                       FontFamily="Microsoft YaHei UI"
                       Margin="10,2,0,0"
                       Foreground="#ffffff"
                       VerticalAlignment="Bottom"
                       FontSize="24"
                       Text="Minutes">
                <TextBlock.Effect>
                    <DropShadowEffect/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Margin="10,-5,0,0"
                       Foreground="{Binding Foreground, ElementName=Days}"
                       Background="Transparent"
                       HorizontalAlignment="Center"
                       FontFamily="#Cascadia Mono Bold"
                       VerticalAlignment="Bottom"
                       FontSize="24"
                       Text="{Binding Text, ElementName=Secs}">
                <TextBlock.Effect>
                    <DropShadowEffect/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Margin="10,14,0,0"
                       Foreground="{Binding Foreground, ElementName=Days}"
                       Background="Transparent"
                       FontFamily="#Cascadia Mono Bold"
                       FontSize="14"
                       Text="{Binding Text, ElementName=Millisecs}">
                <TextBlock.Effect>
                    <DropShadowEffect/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Background="Transparent"
                       HorizontalAlignment="Center"
                       FontFamily="Microsoft YaHei UI"
                       Margin="10,2,0,0"
                       VerticalAlignment="Bottom"
                       FontSize="24"
                       Foreground="#ffffff"
                       Text="Seconds">
                <TextBlock.Effect>
                    <DropShadowEffect/>
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
